"exp5_desc" = "J'ai livré des fonctionnalités iOS en production de bout en bout, en Swift et Objective-C sur des API REST, avec la pleine responsabilité de la production, en parallèle de mes derniers cours à l'université.";

"exp6_role" = "Ingénieur Full Stack";
