// About
"about_heading" = "About";
"about_body" = "Senior iOS Engineer with 6+ years of professional experience, plus 2 earlier years shipping production code while studying for my engineering degree, completed in July 2021. I take full ownership of features and architecture, from the first call to the release: I modernize legacy codebases, build atomic design systems, and treat testing as part of the craft, not an afterthought. On the App Store since 2018 with three shipped apps across iPhone, iPad and Mac. Recently I have carried that ownership past the app layer, into AI agentic workflows, full-stack IoT and hardware-software integration. That ownership runs to the web as well: I build and operate After Dark Stories, a Vapor and Leaf product with its own accounts, billing and moderation, and I write the JavaScript and CSS that front it. Passionate about health and wellness technology. When I'm not shipping, I'm doing yoga, climbing, or kitesurfing.";
"about_availability" = "Available now, freelance or full-time: remote across the EU and the Americas, or relocation. Dual Spanish–Mexican citizen, authorized to work in the EU.";

// Experience
"exp_heading" = "Experience";

"exp1_role" = "Independent iOS Development & Consulting";
"exp1_company" = "Self-directed";
"exp1_meta" = "Remote · Dec 2024 – Present";
"exp1_desc" = "Independent work across client iOS apps, my own products and focused study, owned end-to-end from architecture through release. Architected Living Root end-to-end — SwiftUI client, Vapor backend, MicroPython firmware on ESP32 — and carried that ownership into hardware with a Hydroponics Diploma (Anáhuac University, Feb–Jun 2026) and 3D-printed sensor enclosures. A deliberate immersion in AI agentic workflows, data analysis and modern tooling led to shipping AI and agentic workflows into production apps and tooling (Claude, OpenAI, xAI, Ollama).";

"exp2_role" = "Senior Software Engineer";
"exp2_company" = "Alaska Airlines";
"exp2_meta" = "Remote (US) · Dec 2023 – Nov 2024";
"exp2_desc" = "Drove a comprehensive atomic design system, raising the bar for UI consistency and reuse across the app. Owned technical direction — MVVM, Clean Architecture, Coordinators — shipped features in UIKit and SwiftUI, ran A/B tests to inform product decisions, and mentored engineers.";

"exp3_role" = "Senior iOS Engineer";
"exp3_company" = "Peek.com";
"exp3_meta" = "Remote · Aug 2021 – Aug 2023";
"exp3_desc" = "Led the modernization of a decade-old marketplace app, owning the SwiftUI migration end-to-end on a live product. Made the call to rebuild its foundation on MVVM, Clean Architecture and Coordinators. Raised the performance bar with dynamic lists handling 10,000+ items, built an automated testing culture from zero (Robot Pattern + XCUITest), and cut release cycles 30% with GitHub Actions CI/CD. Integrated GraphQL, and WiFi-connected terminal hardware via custom connection managers; mentored engineers.";

"exp4_role" = "Co-founder & Software Engineer";
"exp4_company" = "Xplain";
"exp4_meta" = "Remote · Aug 2020 – Aug 2021";
"exp4_desc" = "Co-founded the company with friends and led its engineering: a 100% Swift product — Vapor backend, iOS front end, shared Swift libraries between the two — shipping two production iOS apps in SwiftUI and UIKit with secure Stripe payment flows.";

"exp5_role" = "Full Stack Engineer (iOS Focus)";
